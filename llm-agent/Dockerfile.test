FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
WORKDIR /app
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt
# Pinned so CI is reproducible and can't break on a freshly released linter.
# httpx is provided by requirements.txt (app runtime dep) — don't override it here.
RUN pip install --no-cache-dir \
    pytest==9.1.1 pytest-asyncio==1.4.0 ruff==0.16.0 mypy==2.3.0
COPY src/ src/
COPY tests/ tests/
CMD ["pytest", "tests/", "-v"]
